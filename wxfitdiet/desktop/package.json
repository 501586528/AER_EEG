{
  "name": "wxfitdiet-desktop",
  "version": "0.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron": "^31.0.0",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron-builder": "^24.6.5"
  },
  "build": {
    "appId": "com.example.wxfitdiet",
    "productName": "WxFitDiet",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "app/**"],
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" },
    "publish": [
      { "provider": "generic", "url": "https://example.com/updates/" }
    ]
  }
}